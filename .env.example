# ===========================================
# Arlecchino Plus - Environment Variables
# ===========================================
# Copy this file to .env.local for development
# NEVER commit .env.local to version control!

# ===========================================
# Database
# ===========================================
# PostgreSQL connection string
# For local: postgresql://user:password@localhost:5432/arlecchino
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/arlecchino"

# ===========================================
# Authentication
# ===========================================
# Secret for JWT signing (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Admin session cookie name
SESSION_COOKIE_NAME="arlecchino_admin_session"

# ===========================================
# Stripe
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Webhook signing secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===========================================
# PayPal (Optional)
# ===========================================
# Get these from https://developer.paypal.com
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
NEXT_PUBLIC_PAYPAL_CLIENT_ID="..."

# ===========================================
# Email (Resend)
# ===========================================
# Get from https://resend.com
RESEND_API_KEY="re_..."

# Email addresses
EMAIL_FROM="Arlecchino Plus <bestellung@arlecchino-plus.de>"
EMAIL_REPLY_TO="info@arlecchino-plus.de"

# Admin notification email
ADMIN_EMAIL="restaurant@arlecchino-plus.de"

# ===========================================
# Rate Limiting (Upstash Redis)
# ===========================================
# Get from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ===========================================
# File Storage (Optional - Cloudflare R2)
# ===========================================
R2_ACCOUNT_ID="..."
R2_ACCESS_KEY_ID="..."
R2_SECRET_ACCESS_KEY="..."
R2_BUCKET_NAME="arlecchino-images"
R2_PUBLIC_URL="https://images.arlecchino-plus.de"

# ===========================================
# Google Maps (Optional)
# ===========================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="..."

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Arlecchino Plus"

# ===========================================
# Feature Flags
# ===========================================
# Enable/disable features
NEXT_PUBLIC_ENABLE_PAYPAL="false"
NEXT_PUBLIC_ENABLE_GOOGLE_PAY="false"
NEXT_PUBLIC_ENABLE_APPLE_PAY="false"
NEXT_PUBLIC_ENABLE_RESERVATIONS="true"
NEXT_PUBLIC_ENABLE_PRE_ORDER="false"
